# R36 Ultra options on top of ROCKNIX's RK3326 config (rocknix_rk3326_defconfig),
# carried over from the 6.1 branch's rk3326_linux.config where they still exist.
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_DYNAMIC is not set
CONFIG_INITRAMFS_SOURCE=""
CONFIG_LOCALVERSION="-arkos4clone-71"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_COMPACTION=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_PANIC_TIMEOUT=5
# Clone console drivers
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ODROIDGO3=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_ARKOS4CLONE=y
CONFIG_RK915=m
CONFIG_DRM_PANEL_GENERIC_DSI=y
# The image's roots and the ROMs partition
CONFIG_EXT4_FS=y
CONFIG_EXFAT_FS=y
CONFIG_BTRFS_FS=y
CONFIG_AUTOFS_FS=y
# Display: fbcon takes over the U-Boot logo; no VGA hardware
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# CPU quality grade for ES
CONFIG_ROCKCHIP_RK3326_PVTM=y
# Reclaim and zram
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_CRYPTO_LZ4=y
CONFIG_ZRAM=y
# VPU through Rockchip MPP (/dev/mpp_service), which ES decodes videos with
# CONFIG_VIDEO_HANTRO is not set
CONFIG_ROCKCHIP_MPP_SERVICE=y
CONFIG_ROCKCHIP_MPP_VDPU2=y
CONFIG_ROCKCHIP_MPP_VEPU2=y
# RGA2 for librga (/dev/rga): multi-rga, not the V4L2 driver
# CONFIG_VIDEO_ROCKCHIP_RGA is not set
CONFIG_ROCKCHIP_MULTI_RGA=y
# dArkOS renders with libmali: panfrost must not claim the GPU before mali_kbase
# CONFIG_DRM_PANFROST is not set
# Trim what this console doesn't use. Measured against ROCKNIX's general config.
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_KSM is not set
# CONFIG_HIBERNATION is not set
# CONFIG_PSI is not set
# CONFIG_UEVENT_HELPER is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_NFS_FS is not set
# CONFIG_VIDEO_ROCKCHIP_VDEC is not set
# Netfilter stays available for hotspots and VPNs, as modules
CONFIG_NF_CONNTRACK=m
CONFIG_IP_NF_IPTABLES=m
# CONFIG_WERROR is not set
CONFIG_DEBUG_INFO_NONE=y
