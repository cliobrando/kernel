# CONFIG_ETHERNET is not set
CONFIG_MD=y
CONFIG_SND_SOC_ROCKCHIP_PDM=y
CONFIG_VIDEO_ROCKCHIP_CIF=y
# CONFIG_BCACHE is not set
# CONFIG_BLK_DEV_DM is not set
# CONFIG_BLK_DEV_MD is not set
CONFIG_ROCKCHIP_CIF_USE_DUMMY_BUF=y
# CONFIG_ROCKCHIP_CIF_USE_MONITOR is not set
# CONFIG_ROCKCHIP_CIF_USE_NONE_DUMMY_BUF is not set
# CONFIG_ROCKCHIP_CIF_WORKMODE_ONEFRAME is not set
CONFIG_ROCKCHIP_CIF_WORKMODE_PINGPONG=y
CONFIG_VIDEOBUF2_CMA_SG=y

# Clone console tuning, ported from the 5.10 clone_defconfig (R36 Ultra).
# Preemptible kernel: the 5.10 build sets CONFIG_PREEMPT=y to shave input
# latency; keep PREEMPT_DYNAMIC off so the behavior matches 5.10 at boot.
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_DYNAMIC is not set
# Build the linear map with big pages by default instead of 4 KB pages.
# CONFIG_RODATA_FULL_DEFAULT_ENABLED is not set
# High order allocations under memory pressure, per the 5.10 defconfig.
CONFIG_COMPACTION=y
# File systems: the image root is ext4/btrfs; XFS and F2FS stay as modules.
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=m
# Panic early and loudly on lockups, like the 5.10 clone build.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_PANIC_TIMEOUT=5

# Input and frequency governor defaults already in the build .config,
# recorded here so base defconfig + this fragment reproduces the build.
CONFIG_JOYSTICK_ODROIDGO3=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_INTERACTIVE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_INTERACTIVE is not set

# Alternate RK817 gauge, chosen at boot with rk817_gauge=arkos4clone;
# BATTERY_RK817=y comes from the base defconfig.
CONFIG_BATTERY_RK817_ARKOS4CLONE=y
